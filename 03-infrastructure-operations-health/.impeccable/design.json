  "narrative": {
    "northStar": "Operations dispatch ledger",
    "overview": "Cool technical paper, petrol ink and ruled registers make infrastructure evidence readable without suggesting certainty the sources cannot support. Square file tabs and compact status stamps provide personality through filing and annotation, not dashboard decoration.\n\nDesign for an operator and customer reviewing a laptop in a normally lit meeting room: readable system type, aligned measurements, explicit labels and persistent context. The world is customer-neutral and self-contained; it uses no external fonts, imagery or libraries.\n\nThis is the finished scenario-local system extracted from the CSS, markup and JavaScript of `REPORT_HTML` in `generate-infrastructure-operations-report.py`, including its opening five-block direction contract. Frontmatter is normative; `.impeccable/design.json` supplies preview snippets and extensions, not a second token authority.",
    "keyCharacteristics": [
      "Cool paper and restrained petrol ink.",
      "Ruled sheets, square-bodied tabs and compact status stamps.",
      "System sans with tabular measurements and monospace identifiers.",
      "Visible source, units, recorded time, coverage and unknowns.",
      "Immediate, read-only interactions within a dated offline snapshot."
    ],
    "rules": [
      {
        "name": "The Label Before Hue Rule",
        "body": "Every evidence state is named; trace color identifies a resource, not a health grade.",
        "section": "colors"
      },
      {
        "name": "The Measurement Context Rule",
        "body": "Tabular numbers stay attached to visible units, measurement scope and recorded time.",
        "section": "typography"
      },
      {
        "name": "The Ruled Sheet Rule",
        "body": "Use borders and tonal fields to group evidence; do not substitute shadows or floating tiles for the ledger.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep units, source, recorded time and unknown labels adjacent to measurements.",
      "Do use ruled sheets, aligned registers and compact named status stamps.",
      "Do preserve keyboard focus and announce local interaction outcomes.",
      "Do keep component previews free of invented telemetry, brands and deployment claims."
    ],
    "donts": [
      "Don't replace evidence with decorated scores or imply that an observed state certifies health.",
      "Don't turn missing data into zero, connect gaps or invent maxima.",
      "Don't introduce gradients, floating card grids, pill-shaped file tabs or external assets.",
      "Don't label source replay as live validation or publish private replay screenshots as product assets."
    ]
  }
}
